---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SERIES_CONFIG } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const guias = (await getCollection('guias', ({ data }) => !data.draft))
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf());
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title={`Guías — ${SITE_TITLE}`} description="Tutoriales detallados y guías evergreen sobre DevOps, Cloud y Linux." />
    <style>
      .guias-intro {
        margin-bottom: 2rem;
      }
      .series-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 2.5rem;
      }
      .serie-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: 999px;
        text-decoration: none;
        color: var(--text-primary);
        font-size: 0.85rem;
        font-weight: 600;
        transition: border-color 0.2s, transform 0.2s;
      }
      .serie-pill:hover {
        border-color: var(--accent);
        transform: translateY(-2px);
      }
      .serie-pill .pill-badge {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        padding: 0.15rem 0.5rem;
        background: rgba(var(--accent-rgb), 0.15);
        color: var(--accent);
        border-radius: 999px;
        letter-spacing: 0.03em;
      }
      .serie-pill .pill-count {
        font-size: 0.8rem;
        color: var(--text-muted);
        font-weight: 400;
      }
      .guias-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 2rem;
      }
      .guia-card {
        padding: 1.5rem;
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        text-decoration: none;
        color: inherit;
        transition: border-color 0.2s, transform 0.2s;
        display: flex;
        flex-direction: column;
      }
      .guia-card:hover {
        border-color: #10b981;
        transform: translateY(-4px);
      }
      .guia-card h2 {
        font-size: 1.4rem;
        margin: 0.5rem 0;
      }
      .difficulty {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        background: var(--bg-primary);
        border: 1px solid var(--border-color);
        width: fit-content;
      }
      .diff-principiante { color: #10b981; }
      .diff-intermedio { color: #f59e0b; }
      .diff-avanzado { color: #ef4444; }
      /* Light mode: colores oscuros para pasar WCAG AA (ratio ≥ 4.5:1 sobre blanco) */
      :global(html.light) .diff-principiante { color: #047857; } /* emerald-700: 7.2:1 */
      :global(html.light) .diff-intermedio { color: #b45309; }   /* amber-700: 4.9:1 */
      :global(html.light) .diff-avanzado { color: #b91c1c; }     /* red-700: 5.9:1 */
      
      .guia-footer {
        margin-top: auto;
        padding-top: 1rem;
        font-size: 0.85rem;
        color: var(--text-muted);
        display: flex;
        justify-content: space-between;
      }
      .empty-state {
        grid-column: 1 / -1;
        text-align: center;
        padding: 4rem 2rem;
        background: var(--bg-secondary);
        border: 2px dashed var(--border-color);
        border-radius: 16px;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <section class="guias-intro">
        <h1>Guías</h1>
        <p>Tutoriales detallados paso a paso para dominar herramientas y conceptos de infraestructura.</p>
      </section>

      {(() => {
        const seriesWithGuias = Object.entries(SERIES_CONFIG).filter(([slug]) =>
          guias.some(g => g.data.serie === slug)
        );
        if (seriesWithGuias.length === 0) return null;
        return (
          <nav class="series-pills">
            {seriesWithGuias.map(([slug, s]) => {
              const firstGuia = guias
                .filter(g => g.data.serie === slug)
                .sort((a, b) => (a.data.orden ?? 0) - (b.data.orden ?? 0))[0];
              return (
                <a href={`/guias/${firstGuia.id}`} class="serie-pill">
                  <span class="pill-badge">Serie</span>
                  {s.titulo}
                  <span class="pill-count">· {s.total} partes</span>
                </a>
              );
            })}
          </nav>
        );
      })()}

      <section class="guias-grid">
        {guias.length > 0 ? (
          guias.map((guia) => (
            <a href={`/guias/${guia.id}`} class="guia-card">
              <span class={`difficulty diff-${guia.data.dificultad}`}>
                {guia.data.dificultad}
              </span>
              {guia.data.serie && (
                <span style="font-size:0.8rem; color:var(--accent); margin-top:0.5rem; font-weight:bold;">
                  Parte {guia.data.orden} de {SERIES_CONFIG[guia.data.serie]?.total ?? ''}
                </span>
              )}
              <h2>{guia.data.titulo}</h2>
              <p>{guia.data.descripcion}</p>
              <div class="guia-footer">
                <FormattedDate date={guia.data.fecha} />
                {guia.data.tiempo_lectura && <span>{guia.data.tiempo_lectura} min</span>}
              </div>
            </a>
          ))
        ) : (
          <div class="empty-state">
            <h2>Próximamente</h2>
            <p>Estoy preparando guías detalladas. Por ahora, puedes revisar los <a href="/labs">Labs</a>.</p>
          </div>
        )}
      </section>
    </main>
    <Footer />
  </body>
</html>
